{
  "info": {
    "name": "EasyNotes v2 - Flujo de prueba completo",
    "description": "Ejecuta las carpetas EN ORDEN (1 a 9). Cada request guarda automáticamente los IDs/tokens que necesita la siguiente en las variables de la colección, así que no tienes que copiar nada a mano. Al final, la carpeta 9 descarga el boletín en PDF.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "tokenNucleo", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "institucionId", "value": "" },
    { "key": "anioAcademicoId", "value": "" },
    { "key": "areaId", "value": "" },
    { "key": "asignaturaId", "value": "" },
    { "key": "grupoId", "value": "" },
    { "key": "docenteId", "value": "" },
    { "key": "estudianteId", "value": "" },
    { "key": "matriculaId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Ping API",
      "request": { "method": "GET", "url": "http://localhost:3000/" },
      "event": []
    },
    {
      "name": "1. Login Direccion de Nucleo (usa el usuario creado con npm run seed)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{ADMIN_USUARIO}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Login nucleo OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenNucleo', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear Institucion (colegio de prueba)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenNucleo}}" }
        ],
        "url": "{{baseUrl}}/nucleo/instituciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"IE Prueba Postman\",\n  \"nit\": \"900999888-1\",\n  \"direccion\": \"Cra 1 # 1-01\",\n  \"telefono\": \"3000000000\",\n  \"email\": \"contacto@ieprueba.edu.co\",\n  \"dane\": \"268079000999\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Institucion creada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('institucionId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Crear admin del colegio",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenNucleo}}" }
        ],
        "url": "{{baseUrl}}/nucleo/instituciones/{{institucionId}}/admin",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"Administradora\",\n  \"email\": \"admin@ieprueba.edu.co\",\n  \"documento\": \"1000000001\",\n  \"tipoDocumento\": \"CC\",\n  \"credenciales\": { \"usuario\": \"admin.prueba\", \"passwordHash\": \"Prueba123!\" }\n}"
        }
      },
      "event": []
    },
    {
      "name": "4. Login admin del colegio",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin.prueba\",\n  \"password\": \"Prueba123!\",\n  \"institucionId\": \"{{institucionId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Login admin OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenAdmin', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Crear Año Académico",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/anios-academicos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"anio\": 2026,\n  \"estado\": \"activo\",\n  \"configuracion\": { \"numeroPeriodos\": 4 },\n  \"cronograma\": { \"periodos\": [ { \"numero\": 1, \"nombre\": \"Primer periodo\" } ] }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Anio academico creado', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('anioAcademicoId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Crear Area",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/areas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"nombre\": \"Matematicas\",\n  \"porcentaje\": 100,\n  \"orden\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Area creada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('areaId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Crear Asignatura",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/asignaturas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"areaId\": \"{{areaId}}\",\n  \"nombre\": \"Algebra\",\n  \"orden\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Asignatura creada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('asignaturaId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Crear Grupo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/grupos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"anioAcademicoId\": \"{{anioAcademicoId}}\",\n  \"nombre\": \"9-A\",\n  \"grado\": 9\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Grupo creado', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('grupoId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Crear Docente",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"nombres\": \"Carlos\",\n  \"apellidos\": \"Docente\",\n  \"email\": \"docente@ieprueba.edu.co\",\n  \"documento\": \"1000000002\",\n  \"tipoDocumento\": \"CC\",\n  \"tipoPerfil\": \"docente\",\n  \"credenciales\": { \"usuario\": \"docente.prueba\", \"passwordHash\": \"Prueba123!\" }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Docente creado', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('docenteId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Crear Estudiante",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"nombres\": \"Juan\",\n  \"apellidos\": \"Perez Gomez\",\n  \"email\": \"estudiante@ieprueba.edu.co\",\n  \"documento\": \"1005678901\",\n  \"tipoDocumento\": \"TI\",\n  \"tipoPerfil\": \"estudiante\",\n  \"credenciales\": { \"usuario\": \"estudiante.prueba\", \"passwordHash\": \"Prueba123!\" }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Estudiante creado', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('estudianteId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Matricular al estudiante en el grupo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/matriculas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"anioAcademicoId\": \"{{anioAcademicoId}}\",\n  \"estudianteId\": \"{{estudianteId}}\",\n  \"grupoId\": \"{{grupoId}}\",\n  \"tipoMatricula\": \"nueva\",\n  \"numeroMatricula\": \"2026-0001\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Matricula creada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('matriculaId', data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Calificar al estudiante (periodo 1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": "{{baseUrl}}/calificaciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institucionId\": \"{{institucionId}}\",\n  \"anioAcademicoId\": \"{{anioAcademicoId}}\",\n  \"estudianteId\": \"{{estudianteId}}\",\n  \"asignaturaId\": \"{{asignaturaId}}\",\n  \"grupoId\": \"{{grupoId}}\",\n  \"docenteId\": \"{{docenteId}}\",\n  \"periodo\": 1,\n  \"nota\": 4.2,\n  \"observacion\": \"Buen desempeño\"\n}"
        }
      },
      "event": []
    },
    {
      "name": "13. DESCARGAR Boletin PDF (periodo 1)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
        "url": "{{baseUrl}}/reportes/boletin/{{matriculaId}}/1"
      },
      "event": []
    },
    {
      "name": "14. Subir foto del estudiante",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
        "url": "{{baseUrl}}/uploads/usuarios/{{estudianteId}}/foto",
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "imagen", "type": "file", "src": "" }]
        }
      },
      "event": []
    }
  ]
}